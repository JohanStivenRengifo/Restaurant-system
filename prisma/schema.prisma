// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id          String   @id @default(cuid())
  nombre      String
  email       String?
  telefono    String?
  alergias    String[] @default([])
  esFrecuente Boolean  @default(false)
  puntos      Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  pedidos     Pedido[]
  facturas    Factura[]
  reservas    Reserva[]

  // Índices para mejorar rendimiento
  @@index([esFrecuente])
  @@index([createdAt])
  @@map("clientes")
}

model Mesa {
  id        String     @id @default(cuid())
  numero    Int        @unique
  capacidad Int
  estado    EstadoMesa @default(DISPONIBLE)
  ubicacion String?
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relaciones
  pedidos   Pedido[]
  reservas  Reserva[]

  // Índices para mejorar rendimiento
  @@index([estado])
  @@map("mesas")
}

model Categoria {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  platillos   Platillo[]

  @@map("categorias")
}

model Platillo {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Float
  categoriaId String
  alergenos   String[] @default([])
  activo      Boolean  @default(true)
  imagen      String?
  tiempoPrep  Int      @default(15) // minutos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  pedidoPlatillos PedidoPlatillo[]

  @@map("platillos")
}

model Ingrediente {
  id          String   @id @default(cuid())
  nombre      String
  unidad      String
  stock       Float    @default(0)
  stockMinimo Float    @default(0)
  costo       Float    @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ingredientes")
}

model Pedido {
  id        String      @id @default(cuid())
  clienteId String?
  mesaId    String?
  tipo      TipoPedido
  estado    EstadoPedido @default(RECIBIDO)
  total     Float       @default(0)
  notas     String?
  direccion String?
  telefono  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relaciones
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  mesa      Mesa?   @relation(fields: [mesaId], references: [id])
  platillos PedidoPlatillo[]
  facturas  Factura[]

  // Índices para mejorar rendimiento
  @@index([createdAt])
  @@index([estado])
  @@map("pedidos")
}

model PedidoPlatillo {
  id              String   @id @default(cuid())
  pedidoId        String
  platilloId      String
  cantidad        Int
  precioUnitario  Float
  precio          Float
  personalizacion String[] @default([])
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  pedido   Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  platillo Platillo @relation(fields: [platilloId], references: [id])

  @@map("pedido_platillos")
}

model Factura {
  id            String        @id @default(cuid())
  pedidoId      String?
  clienteId    String?
  numero        String        @unique
  subtotal      Float
  descuento     Float         @default(0)
  impuestos     Float         @default(0)
  iva           Float         @default(0)
  total         Float
  metodoPago    MetodoPago
  estado        EstadoFactura @default(PENDIENTE)
  fecha         DateTime      @default(now())
  clienteNombre String?
  esElectronica Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relaciones
  pedido  Pedido?  @relation(fields: [pedidoId], references: [id])
  cliente Cliente? @relation(fields: [clienteId], references: [id])
  items   FacturaItem[]

  // Índices para mejorar rendimiento
  @@index([createdAt])
  @@index([estado])
  @@map("facturas")
}

model FacturaItem {
  id          String   @id @default(cuid())
  facturaId   String
  nombre      String
  cantidad    Int
  precio      Float
  subtotal    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("factura_items")
}

model Reserva {
  id            String      @id @default(cuid())
  clienteId     String?
  mesaId        String?
  fecha         DateTime
  hora          String
  personas      Int
  estado        EstadoReserva @default(PENDIENTE)
  notas         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relaciones
  cliente Cliente? @relation(fields: [clienteId], references: [id])
  mesa    Mesa?   @relation(fields: [mesaId], references: [id])

  @@map("reservas")
}

// Enums
enum EstadoMesa {
  DISPONIBLE
  OCUPADA
  RESERVADA
  MANTENIMIENTO
}

enum TipoPedido {
  MESA
  DOMICILIO
  RECOGER
}

enum EstadoPedido {
  RECIBIDO
  PREPARANDO
  LISTO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  CANCELADA
  REEMBOLSADA
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}